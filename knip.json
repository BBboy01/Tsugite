{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "types"],
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.spec.ts",
        "e2e/**/*harness.tsx",
        "e2e/server.ts",
        "e2e/vite.config.ts",
        "playwright.config.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "e2e/**/*.{ts,tsx,css}",
        "*.config.{ts,mjs}"
      ]
    },
    "apps/web": {
      "entry": ["src/styles.css", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/server": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
