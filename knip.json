{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "types"],
  "workspaces": {
    ".": {
      "entry": [
        "apps/web/src/styles.css",
        "apps/**/*.test.ts",
        "e2e/**/*.spec.ts",
        "playwright.config.ts"
      ],
      "project": ["apps/**/*.{ts,tsx}", "apps/**/*.css", "e2e/**/*.ts", "*.config.{ts,mjs}"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
