{
  "name": "tsugite-multiplayer-editor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "dev:server": "bun run apps/server/src/index.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "knip": "knip",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write package.json knip.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json apps/web/index.html apps/web/src apps/server/src packages/shared/src e2e",
    "format:check": "oxfmt --check package.json knip.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json apps/web/index.html apps/web/src apps/server/src packages/shared/src e2e",
    "lint": "oxlint apps/web/src apps/server/src packages/shared/src e2e playwright.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "latest",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "latest",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@elysiajs/cors": "latest",
    "@faker-js/faker": "^10.6.0",
    "@iris/shared": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@react-symbols/icons": "^1.4.1",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@typescript/vfs": "^1.6.4",
    "@valtown/codemirror-ts": "^2.3.1",
    "@webcontainer/api": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "latest",
    "elysia": "latest",
    "i18next": "^26.4.0",
    "loro-codemirror": "latest",
    "loro-crdt": "latest",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "react": "latest",
    "react-aria-components": "^1.21.0",
    "react-dom": "latest",
    "react-i18next": "^17.0.12",
    "shadcn": "^4.19.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript-legacy": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "latest",
    "vite-plugin-wasm": "^3.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --no-install lint-staged && bun run typecheck",
    "commit-msg": "bunx --no-install commitlint --edit \"$1\""
  }
}
