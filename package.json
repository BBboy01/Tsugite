{
  "name": "tsugite-multiplayer-editor",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "dev:server": "bun run apps/server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "knip": "knip",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write package.json knip.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json apps/web/index.html apps/web/src apps/server/src packages/shared/src e2e",
    "format:check": "oxfmt --check package.json knip.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json apps/web/index.html apps/web/src apps/server/src packages/shared/src e2e",
    "lint": "oxlint apps/web/src apps/server/src packages/shared/src e2e playwright.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "8.0.9",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@elysiajs/cors": "1.4.2",
    "@faker-js/faker": "^10.6.0",
    "@iris/shared": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@pierre/highlights": "0.2.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/themes": "^3.3.0",
    "@react-symbols/icons": "^1.4.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-virtual": "3.14.22",
    "@webcontainer/api": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "elysia": "1.4.30",
    "i18next": "^26.5.10",
    "jotai": "^3.0.1",
    "loro-codemirror": "0.3.3",
    "loro-crdt": "1.17.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript-legacy": "npm:typescript@6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-wasm": "^3.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --no-install lint-staged && bun run typecheck",
    "commit-msg": "bunx --no-install commitlint --edit \"$1\""
  }
}
