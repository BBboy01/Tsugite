{
  "name": "tsugite-multiplayer-editor",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file scripts/dev.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:server": "bun run apps/server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "bun --no-env-file run --bun vite build --config vite.config.ts",
    "build:server": "bun --no-env-file scripts/build-server.ts",
    "test:server:standalone": "bun --no-env-file test scripts/server-standalone.test.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "knip": "knip",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "typecheck": "bun --no-env-file check",
    "format": "bun --no-env-file fmt",
    "format:check": "bun --no-env-file fmt --check",
    "lint": "bun --no-env-file lint --no-script && bun --no-env-file run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iris/shared": "workspace:*",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "jotai": "^3.0.2",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "motion": "^14.14.0",
    "playwright": "^1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-git-hooks": "^2.14.0",
    "vite": "8.3.8",
    "vite-plugin-wasm": "^3.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun --no-env-file x --no-install lint-staged && bun --no-env-file run typecheck",
    "commit-msg": "bun --no-env-file x --no-install commitlint --edit \"$1\""
  }
}
