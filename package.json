{
  "name": "tsugite-multiplayer-editor",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "dev:server": "bun run apps/server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "knip": "knip",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "typecheck": "bun --no-env-file check",
    "format": "bun --no-env-file fmt",
    "format:check": "bun --no-env-file fmt --check",
    "lint": "bun --no-env-file lint --no-script && bun --no-env-file run typecheck"
  },
  "dependencies": {
    "@babel/standalone": "8.1.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@elysiajs/cors": "1.4.3",
    "@faker-js/faker": "^10.6.0",
    "@iris/shared": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@pierre/highlights": "0.5.2",
    "@pierre/trees": "1.0.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/themes": "^3.3.0",
    "@react-symbols/icons": "^1.4.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@webcontainer/api": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "elysia": "1.4.32",
    "i18next": "^27.2.2",
    "jotai": "^3.0.2",
    "loro-codemirror": "0.3.3",
    "loro-crdt": "1.18.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript-legacy": "npm:typescript@6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "shadcn": "^4.23.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.8",
    "vite-plugin-wasm": "^3.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun --no-env-file x --no-install lint-staged && bun --no-env-file run typecheck",
    "commit-msg": "bun --no-env-file x --no-install commitlint --edit \"$1\""
  }
}
