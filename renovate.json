{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    ":prHourlyLimitNone",
    ":semanticPrefixFixDepsChoreOthers",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "ignoreDeps": [],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "schedule": "on monday before 5:00am",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "timezone": "Asia/Shanghai",
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "Keep application updates separate unless explicitly grouped below",
      "matchManagers": ["npm", "bun"],
      "groupName": null,
      "groupSlug": null,
      "separateMajorMinor": true,
      "separateMinorPatch": false
    },
    {
      "description": "Group stable non-major updates across exact, caret and tilde versions",
      "matchManagers": ["npm", "bun"],
      "matchCurrentValue": "/^[~^]?[1-9]\\d*\\.\\d+\\.\\d+(\\+[0-9A-Za-z.-]+)?$/",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major-dependencies"
    },
    {
      "description": "Update Drizzle ORM and Kit together, including release candidates",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"],
      "groupName": "drizzle",
      "groupSlug": "drizzle",
      "separateMajorMinor": true,
      "separateMinorPatch": false
    },
    {
      "description": "Group GitHub Actions updates while keeping major upgrades separate",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true,
      "separateMinorPatch": false
    }
  ]
}
